# Base URL del backend (no incluir la barra final)
VITE_API_URL=http://localhost:8081/api

# Puerto de desarrollo de Vite (ajusta si cambias el default)
# VITE_PORT=5174

# ==================================================
# CONFIGURACIÓN DE SIIGO - FACTURACIÓN ELECTRÓNICA
# ==================================================

# URLs de API de Siigo
VITE_SIIGO_API_URL=https://api.siigo.com/v1
VITE_SIIGO_AUTH_URL=https://api.siigo.com/auth

# Identificador del partner (no cambiar)
VITE_SIIGO_PARTNER_ID=IPS-GESTION

# ==================================================
# CREDENCIALES DE SIIGO
# ==================================================
# NOTA: Las credenciales se configuran desde la interfaz
# en Configuración > Siigo API
# 
# Para ambiente de pruebas (Sandbox):
# - Username: usuario_sandbox@ejemplo.com
# - Access Key: [Obtener desde portal de Siigo]
#
# Para ambiente de producción:
# - Username: [Tu email de Siigo]
# - Access Key: [Tu token de acceso]
#
# Documentación: https://siigoapi.docs.apiary.io/
